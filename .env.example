# Public Supabase browser configuration
EVENTHUB_SUPABASE_URL=https://your-project.supabase.co
EVENTHUB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Vercel configuration — never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated email addresses allowed to use admin APIs.
EVENTHUB_ADMIN_EMAILS=admin@example.com
